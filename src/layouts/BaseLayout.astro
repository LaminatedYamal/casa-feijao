---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'pt' | 'en';
  canonicalUrl?: string;
  image?: string;
  isHeroMuralPage?: boolean;
}

const {
  title,
  description,
  lang = 'pt',
  canonicalUrl = Astro.url.href,
  image = '/images/_geres_casa_feijao_2.jpg',
  isHeroMuralPage = false,
} = Astro.props;

const siteTitle = title ? `${title} | Casa Feijão Gerês` : 'Casa Feijão - Alojamento Local no Gerês';

// JSON-LD Structured Data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  'name': 'Casa Feijão - Alojamento Local',
  'description': 'Alojamento no coração do Gerês. Apartamentos T3, T1 e Estúdio em Vilar da Veiga.',
  'url': 'https://casafeijao.com',
  'telephone': '+351253391971',
  'email': 'info@casafeijao.com',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': 'Rua Corga de Loureiro, 30',
    'addressLocality': 'Vilar da Veiga, Gerês',
    'postalCode': '4845-076',
    'addressCountry': 'PT',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': '41.7132',
    'longitude': '-8.1724',
  },
  'priceRange': '70€ - 180€',
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': '8.9',
    'reviewCount': '85',
  },
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FAFBFD" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- High-Performance Typography: Preconnect & Swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Automatic Browser Language Detection -->
    <script is:inline>
      (function() {
        try {
          const hasAutoRedirected = sessionStorage.getItem('cf_lang_detected');
          if (!hasAutoRedirected) {
            sessionStorage.setItem('cf_lang_detected', 'true');
            const userLangs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || 'pt'];
            const primaryLang = (userLangs[0] || 'pt').toLowerCase();
            const isPtBrowser = primaryLang.startsWith('pt');
            const path = window.location.pathname.replace(/\/$/, '') || '/';

            const ptToEnMap = {
              '/': '/en',
              '/acomodacoes': '/en/accommodations',
              '/acomodacoes/t3': '/en/accommodations/t3',
              '/acomodacoes/t1': '/en/accommodations/t1',
              '/acomodacoes/estudio': '/en/accommodations/studio',
              '/geres': '/en/geres',
              '/facilidades': '/en/facilities',
              '/contactos': '/en/contact'
            };

            const enToPtMap = {
              '/en': '/',
              '/en/accommodations': '/acomodacoes',
              '/en/accommodations/t3': '/acomodacoes/t3',
              '/en/accommodations/t1': '/acomodacoes/t1',
              '/en/accommodations/studio': '/acomodacoes/estudio',
              '/en/geres': '/geres',
              '/en/facilities': '/facilidades',
              '/en/contact': '/contactos'
            };

            if (!isPtBrowser && ptToEnMap[path]) {
              window.location.replace(ptToEnMap[path]);
            } else if (isPtBrowser && enToPtMap[path]) {
              window.location.replace(enToPtMap[path]);
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-granite-900 selection:bg-cobalt-100 selection:text-cobalt-900 font-sans antialiased">
    <Header lang={lang} currentPath={Astro.url.pathname} isHeroMuralPage={isHeroMuralPage} />
    <main class="flex-grow">
      <slot />
    </main>
    {!isHeroMuralPage && <Footer lang={lang} />}
  </body>
</html>
