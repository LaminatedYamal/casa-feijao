---
// src/pages/geres.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import { url } from '../utils/paths';
---

<BaseLayout
  title="Guia Completo do Gerês • Cascatas, Praias, Trilhos & Gastronomia • Casa Feijão"
  description="O guia consolidado da Casa Feijão para explorar a Peneda-Gerês: coordenadas GPS do Poço Azul e Cascatas, praias fluviais da Caniçada, termas de Torneros, Via Romana da Geira, São Bento e gastronomia minhota."
  lang="pt"
>
  <!-- Guide Header Hero -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-[#FAFBFD] to-white border-b border-cobalt-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Guia do Gerês' }]} lang="pt" className="mb-6" />
      <div class="text-center max-w-3xl mx-auto">
        <!-- Clean Text Overline without Pill Box -->
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-[#0B357B] mb-3 font-sans">
          Concierge Local Casa Feijão • Vilar da Veiga
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-black text-cobalt-950 tracking-tight">
          O Guia Definitivo do Gerês
        </h1>
      <p class="mt-4 text-sm sm:text-base text-granite-600 leading-relaxed font-sans">
        Consolidámos os segredos mais bem guardados do Parque Nacional da Peneda-Gerês. Descubra os caminhos pedestres, coordenadas GPS exatas para poços secretos, praias fluviais a passos do nosso alojamento e os melhores sabores minhotos.
      </p>

      <!-- Navigation Jump Links -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 mt-8 font-sans">
        <a href="#meteorologia" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm88,80a8,8,0,0,0-16,0v24a8,8,0,0,0,16,0Zm96-88H208a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"/>
          </svg>
          <span>Meteorologia em Direto</span>
        </a>
        <a href="#cascatas" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M174.63,94.34,133.66,53.37a8,8,0,0,0-11.32,0L81.37,94.34a64,64,0,1,0,93.26,0ZM128,208a48,48,0,0,1-33.94-81.94L128,92.11l33.94,33.95A48,48,0,0,1,128,208Z"/>
          </svg>
          <span>Cascatas & Lagoas (GPS)</span>
        </a>
        <a href="#video-geres" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM56,56H72V80H56Zm0,40H72v24H56Zm0,40H72v24H56Zm0,40H72v24H56Zm144,24H88V56h112Zm16-24H200V176h16Zm0-40H200V136h16Zm0-40H200V96h16Zm0-40H200V56h16Z"/>
          </svg>
          <span>Vídeo das Cascatas</span>
        </a>
        <a href="#praias" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M239.57,100.43a8,8,0,0,0-11.14.88,44,44,0,0,1-64.86,0,8,8,0,0,0-11.14,0,44,44,0,0,1-64.86,0,8,8,0,0,0-11.14,0,44,44,0,0,1-64.86,0,8,8,0,1,0-12,10.58,59.89,59.89,0,0,0,88.86,0,59.89,59.89,0,0,0,88.86,0,59.89,59.89,0,0,0,88.86,0A8,8,0,0,0,239.57,100.43Zm0,48a8,8,0,0,0-11.14.88,44,44,0,0,1-64.86,0,8,8,0,0,0-11.14,0,44,44,0,0,1-64.86,0,8,8,0,0,0-11.14,0,44,44,0,0,1-64.86,0,8,8,0,1,0-12,10.58,59.89,59.89,0,0,0,88.86,0,59.89,59.89,0,0,0,88.86,0,59.89,59.89,0,0,0,88.86,0A8,8,0,0,0,239.57,148.43Z"/>
          </svg>
          <span>Praias Fluviais & Albufeira</span>
        </a>
        <a href="#patrimonio" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M208,128a55.93,55.93,0,0,0-17.76-40.75,72,72,0,0,0-124.48,0A56,56,0,0,0,48,184h72v48a8,8,0,0,0,16,0V184h72A56.06,56.06,0,0,0,208,128ZM128,32a56,56,0,0,1,49.88,30.67,8,8,0,0,0,8.74,4.11A40,40,0,0,1,208,128a40.07,40.07,0,0,1-30.86,39,8,8,0,0,0-6.14,6.72A8,8,0,0,0,172,168H84a8,8,0,0,0,1-1.28,8,8,0,0,0-6.14-6.72A40.07,40.07,0,0,1,48,128a40,40,0,0,1,21.38-35.22,8,8,0,0,0,8.74-4.11A56,56,0,0,1,128,32Z"/>
          </svg>
          <span>Serra, Mata & Geira Romana</span>
        </a>
        <a href="#termas-santuario" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M213.85,125.46l-65.31-24-24-65.31a8,8,0,0,0-15,0l-24,65.31-65.31,24a8,8,0,0,0,0,15.08l65.31,24,24,65.31a8,8,0,0,0,15,0l24-65.31,65.31-24A8,8,0,0,0,213.85,125.46Z"/>
          </svg>
          <span>Termas & São Bento da Porta Aberta</span>
        </a>
        <a href="#gastronomia" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-cobalt-200 text-xs font-semibold text-[#0B357B] hover:bg-cobalt-50 shadow-2xs transition-all">
          <svg class="w-3.5 h-3.5 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
            <path d="M208,88a80.11,80.11,0,0,1-72,79.6V208h24a8,8,0,0,1,0,16H96a8,8,0,0,1,0-16h24V167.6A80.11,80.11,0,0,1,48,88V40a8,8,0,0,1,8-8H200a8,8,0,0,1,8,8ZM64,48V88a64,64,0,0,0,128,0V48Z"/>
          </svg>
          <span>Gastronomia & Vinhos Minhotos</span>
        </a>
      </div>
    </div>
  </div>
</section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">
    <!-- SECTION 0: LIVE WEATHER WIDGET -->
    <section id="meteorologia" class="scroll-mt-36">
      <WeatherWidget
        lang="pt"
        title="Previsão Meteorológica no Parque Nacional"
        subtitle="Condições atmosféricas em tempo real para planeamento de caminhadas, banhos nas lagoas e passeios de barco"
      />
    </section>

    <!-- SECTION 1: CASCATAS & LAGOAS SECRETAS (COM GPS E FOTOS REAIS) -->
    <section id="cascatas" class="scroll-mt-36 space-y-8">
      <div class="border-b border-cobalt-100 pb-4">
        <span class="text-xs font-sans uppercase tracking-widest text-[#0B357B] font-semibold">Natureza Selvagem</span>
        <h2 class="text-3xl sm:text-4xl font-serif font-black text-cobalt-950 mt-1">
          Cascatas & Lagoas Naturais do Gerês
        </h2>
        <p class="text-xs sm:text-sm text-granite-600 mt-2 font-sans">
          Águas cristalinas nascidas nas cumeadas graníticas da serra. Guarde estas coordenadas de satélite no seu GPS:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Poço Azul -->
        <article class="bg-[#FAFBFD] rounded-3xl overflow-hidden border border-cobalt-100 shadow-tile flex flex-col justify-between group">
          <div>
            <div class="relative h-56 overflow-hidden">
              <img
                src="/images/_Poçoazulgeres.jpg"
                alt="Poço Azul no Gerês"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <!-- Tag Always Blue -->
              <div class="absolute top-3 left-3 bg-[#0B357B] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs font-sans">
                Trilho PR14 • 16 km
              </div>
            </div>
            <div class="p-6 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-serif font-bold text-cobalt-950">O Mítico Poço Azul</h3>
                <span class="text-[10px] font-sans font-semibold bg-cobalt-50 text-[#0B357B] border border-cobalt-200/60 px-2 py-0.5 rounded">Lagoa Turquesa</span>
              </div>
              <p class="text-xs text-granite-600 leading-relaxed font-sans">
                Um dos locais mais sagrados da serra. Acesso exclusivamente a pé a partir de Ermida pelo PR14 (Sobreiral da Ermida), passando pela Fonte do Arado e Tribela até ao Rio Conho, onde um poço de azul profundo recompensa o esforço.
              </p>
            </div>
          </div>
          <!-- Clean GPS without background pill -->
          <div class="px-6 pb-6 pt-0">
            <div class="flex items-center gap-1.5 text-xs text-granite-600 font-sans">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,202.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"/>
              </svg>
              <span class="font-mono text-[11px] font-semibold text-cobalt-950">GPS: 41°44'00.6"N 8°06'25.3"W</span>
            </div>
          </div>
        </article>

        <!-- Cascata do Arado -->
        <article class="bg-[#FAFBFD] rounded-3xl overflow-hidden border border-cobalt-100 shadow-tile flex flex-col justify-between group">
          <div>
            <div class="relative h-56 overflow-hidden">
              <img
                src="/images/_Cascatadoarado2.jpg"
                alt="Cascata do Arado"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <!-- Tag Always Blue -->
              <div class="absolute top-3 left-3 bg-[#0B357B] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs font-sans">
                A 3,7 km da Casa Feijão
              </div>
            </div>
            <div class="p-6 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-serif font-bold text-cobalt-950">Cascata do Arado</h3>
                <span class="text-[10px] font-sans font-semibold bg-cobalt-50 text-[#0B357B] border border-cobalt-200/60 px-2 py-0.5 rounded">900m Altitude</span>
              </div>
              <p class="text-xs text-granite-600 leading-relaxed font-sans">
                Situada a 900 metros de altitude no Rio Arado. Uma sucessão impressionante de quedas de água rasgando o maciço rochoso até a uma bacia transparente. Acesso fácil a partir da aldeia da Ermida até à ponte do Arado com escadaria e miradouro.
              </p>
            </div>
          </div>
          <!-- Clean GPS without background pill -->
          <div class="px-6 pb-6 pt-0">
            <div class="flex items-center gap-1.5 text-xs text-granite-600 font-sans">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,202.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"/>
              </svg>
              <span class="font-mono text-[11px] font-semibold text-cobalt-950">GPS: 41°43'28.5"N 8°07'47.0"W</span>
            </div>
          </div>
        </article>

        <!-- As 7 Lagoas do Gerês -->
        <article class="bg-[#FAFBFD] rounded-3xl overflow-hidden border border-cobalt-100 shadow-tile flex flex-col justify-between group">
          <div>
            <div class="relative h-56 overflow-hidden">
              <img
                src="/images/_7lagoasdogeres_CASA_FEIJAO_GERES.jpg"
                alt="As 7 Lagoas do Gerês Cabril"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <!-- Tag Always Blue -->
              <div class="absolute top-3 left-3 bg-[#0B357B] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs font-sans">
                Cabril • 12 km A Pé / 4x4
              </div>
            </div>
            <div class="p-6 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-serif font-bold text-cobalt-950">As 7 Lagoas de Cabril</h3>
                <span class="text-[10px] font-sans font-semibold bg-cobalt-50 text-[#0B357B] border border-cobalt-200/60 px-2 py-0.5 rounded">7 Bacias Naturais</span>
              </div>
              <p class="text-xs text-granite-600 leading-relaxed font-sans">
                De todas as maravilhas aquáticas da serra, as 7 Lagoas são as mais fascinantes. Sete piscinas esculpidas no leito de granito ao longo do rio de montanha. Acesso a pé ou jipe todo-o-terreno a partir de Cabril.
              </p>
            </div>
          </div>
          <!-- Clean GPS without background pill -->
          <div class="px-6 pb-6 pt-0">
            <div class="flex items-center gap-1.5 text-xs text-granite-600 font-sans">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,202.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"/>
              </svg>
              <span class="font-mono text-[11px] font-semibold text-cobalt-950">Cabril, Montalegre</span>
            </div>
          </div>
        </article>

        <!-- Cascata Tahiti (Fecha de Barjas) -->
        <article class="bg-[#FAFBFD] rounded-3xl overflow-hidden border border-cobalt-100 shadow-tile flex flex-col justify-between group">
          <div>
            <div class="relative h-56 overflow-hidden">
              <img
                src="/images/_Cascata-do-Tahiti-5.jpg"
                alt="Cascata Tahiti Fecha de Barjas"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <!-- Tag Always Blue -->
              <div class="absolute top-3 left-3 bg-[#0B357B] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs font-sans">
                A 4,8 km da Casa Feijão
              </div>
            </div>
            <div class="p-6 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-serif font-bold text-cobalt-950">Cascata Tahiti (Fecha de Barjas)</h3>
                <span class="text-[10px] font-sans font-semibold bg-cobalt-50 text-[#0B357B] border border-cobalt-200/60 px-2 py-0.5 rounded">Areia & Moinhos</span>
              </div>
              <p class="text-xs text-granite-600 leading-relaxed font-sans">
                No Rio Arado, caminho para Cabril. Descida a pé a partir da ponte de madeira com vestígios de moinhos rústicos e lagoas de areia fina de rio ideais para mergulhos nos dias de verão.
              </p>
            </div>
          </div>
          <!-- Clean GPS without background pill -->
          <div class="px-6 pb-6 pt-0">
            <div class="flex items-center gap-1.5 text-xs text-granite-600 font-sans">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,202.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"/>
              </svg>
              <span class="font-mono text-[11px] font-semibold text-cobalt-950">Rio Arado, Vilar da Veiga</span>
            </div>
          </div>
        </article>

        <!-- Cascata Rio Homem / Leonte -->
        <article class="bg-[#FAFBFD] rounded-3xl overflow-hidden border border-cobalt-100 shadow-tile flex flex-col justify-between group">
          <div>
            <div class="relative h-56 overflow-hidden">
              <img
                src="/images/_cascatariohomem3.jpg"
                alt="Cascata Rio Homem Leonte"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <!-- Tag Always Blue -->
              <div class="absolute top-3 left-3 bg-[#0B357B] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs font-sans">
                Mata da Albergaria
              </div>
            </div>
            <div class="p-6 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-serif font-bold text-cobalt-950">Cascata Rio Homem / Leonte</h3>
                <span class="text-[10px] font-sans font-semibold bg-cobalt-50 text-[#0B357B] border border-cobalt-200/60 px-2 py-0.5 rounded">Saltos de 10m</span>
              </div>
              <p class="text-xs text-granite-600 leading-relaxed font-sans">
                Junto à ponte na estrada para a Portela do Homem, a cerca de 2 km da fronteira com Espanha. Lagoa profunda de montanha rodeada por vegetação exuberante, muito procurada para saltos.
              </p>
            </div>
          </div>
          <!-- Clean GPS without background pill -->
          <div class="px-6 pb-6 pt-0">
            <div class="flex items-center gap-1.5 text-xs text-granite-600 font-sans">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
