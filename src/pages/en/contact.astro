---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Contact & Directions • Casa Feijão Gerês"
  description="Contact details for Casa Feijão Guesthouse in Vilar da Veiga, Gerês. Phone (+351) 253 391 971 and 933 176 678, email and arrival directions."
  lang="en"
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-[#FAFBFD] to-white border-b border-cobalt-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Contact & Location' }]} lang="en" className="mb-6" />
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-[#0B357B] mb-3 font-sans">
          Direct Support Line • Vilar da Veiga
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-cobalt-950 tracking-tight">
          Contact & Location
        </h1>
        <p class="mt-4 text-sm sm:text-base text-granite-600 leading-relaxed font-sans">
          Nestled on the green slope of Vilar da Veiga, minutes from Caniçada reservoir and Gerês Village. Reach out directly for questions, advice, or reservation inquiries.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-6">
        <div class="p-8 rounded-3xl bg-emerald-50 border border-emerald-200 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-600 text-white text-[11px] font-semibold uppercase tracking-wider">
            Fastest Channel
          </div>
          <h2 class="text-2xl font-serif font-bold text-emerald-950">
            WhatsApp with Reception
          </h2>
          <p class="text-xs text-emerald-800 leading-relaxed">
            Message us directly to check real-time availability, ask access questions, or request baby cribs.
          </p>
          <a
            href="https://wa.me/351933176678?text=Hello%20Casa%20Feij%C3%A3o!%20I%20would%20like%20information%20about%20booking."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm"
          >
            Open WhatsApp (+351 933 176 678) →
          </a>
        </div>

        <div class="p-8 rounded-3xl bg-white border border-cobalt-100 shadow-tile space-y-6">
          <div>
            <span class="text-[10px] font-mono uppercase text-granite-400 block tracking-widest">Official Address</span>
            <p class="text-sm font-semibold text-cobalt-950 mt-1">
              Residência Casa Feijão<br />
              Rua Corga de Loureiro, 30<br />
              4845-076 Vilar da Veiga • Gerês, Portugal
            </p>
          </div>

          <div class="pt-4 border-t border-granite-100 space-y-2">
            <span class="text-[10px] font-mono uppercase text-granite-400 block tracking-widest">Telephone</span>
            <a href="tel:+351253391971" class="flex items-center gap-2 text-sm font-mono font-semibold text-cobalt-900 hover:text-cobalt-700">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/>
              </svg>
              <span>(+351) 253 391 971 (Landline)</span>
            </a>
            <a href="tel:+351933176678" class="flex items-center gap-2 text-sm font-mono font-semibold text-cobalt-900 hover:text-cobalt-700">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M176,16H80A24,24,0,0,0,56,40V216a24,24,0,0,0,24,24h96a24,24,0,0,0,24-24V40A24,24,0,0,0,176,16ZM72,40a8,8,0,0,1,8-8h96a8,8,0,0,1,8,8v128H72Zm112,176a8,8,0,0,1-8,8H80a8,8,0,0,1-8-8V184H184Zm-56-12a12,12,0,1,1,12-12A12,12,0,0,1,128,204Z"/>
              </svg>
              <span>(+351) 933 176 678 (Mobile / WhatsApp)</span>
            </a>
          </div>

          <div class="pt-4 border-t border-granite-100">
            <span class="text-[10px] font-mono uppercase text-granite-400 block tracking-widest">Email</span>
            <a href="mailto:info@casafeijao.com" class="flex items-center gap-2 text-sm font-semibold text-cobalt-800 hover:text-cobalt-950">
              <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                <path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM203.43,64,128,133.15,52.57,64ZM216,192H40V74.19l82.59,75.71a8,8,0,0,0,10.82,0L216,74.19V192Z"/>
              </svg>
              <span>info@casafeijao.com</span>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <div class="p-8 rounded-3xl bg-white border border-cobalt-100 shadow-tile space-y-6">
          <h2 class="text-2xl font-serif font-bold text-cobalt-950">Getting Here</h2>
          <div class="space-y-4 text-xs text-granite-700 leading-relaxed">
            <p>
              <strong>From Porto Airport / OPO (1h 15m):</strong> Take the A3 motorway toward Braga, then follow EN101/EN304 heading to Rio Caldo and Vilar da Veiga.
            </p>
            <p>
              <strong>From Vigo, Spain (1h 30m):</strong> Enter via Portela do Homem mountain pass, crossing the ancient Mata da Albergaria oak woods and descending into Vilar da Veiga.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-porcelain border border-cobalt-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-cobalt-600 font-bold block">GPS Coordinates</span>
              <span class="text-sm font-mono font-bold text-cobalt-950">41°42'47.5"N 8°10'20.6"W</span>
            </div>
            <a
              href="https://maps.google.com/?q=Casa+Feijão+Vilar+da+Veiga+Geres"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl bg-[#0B357B] text-white text-xs font-semibold hover:bg-cobalt-900 transition-colors"
            >
              Open in Google Maps →
            </a>
          </div>

          <!-- Distances summary -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t border-granite-100 text-center">
            <div class="p-3 rounded-xl bg-granite-50">
              <span class="text-[10px] text-granite-500 block">River Beach</span>
              <span class="text-xs font-bold text-cobalt-950">6 min walk</span>
            </div>
            <div class="p-3 rounded-xl bg-granite-50">
              <span class="text-[10px] text-granite-500 block">Gerês Village</span>
              <span class="text-xs font-bold text-cobalt-950">2.0 km</span>
            </div>
            <div class="p-3 rounded-xl bg-granite-50">
              <span class="text-[10px] text-granite-500 block">Arado Waterfall</span>
              <span class="text-xs font-bold text-cobalt-950">3.7 km</span>
            </div>
          </div>
        </div>

        <!-- Direct Reservation Inquiry Form (#booking and #reserva) -->
        <div id="booking" class="p-8 rounded-3xl bg-[#FAFBFD] border-2 border-cobalt-200/80 shadow-tile space-y-6 scroll-mt-36">
          <div class="flex items-center justify-between border-b border-cobalt-100 pb-3">
            <div>
              <span class="text-[10px] font-mono uppercase text-[#0B357B] font-bold block">Information & Reservation Request</span>
              <h3 class="text-xl font-serif font-black text-cobalt-950">Check Direct Availability</h3>
            </div>
            <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-bold border border-emerald-200">
              Best Rate Guaranteed
            </span>
          </div>

          <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold text-granite-700 mb-1">Full Name *</label>
                <input
                  type="text"
                  required
                  placeholder="Your full name"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-cobalt-200 bg-white focus:outline-hidden focus:ring-2 focus:ring-[#0B357B] text-xs"
                />
              </div>
              <div>
                <label class="block font-semibold text-granite-700 mb-1">Phone / WhatsApp *</label>
                <input
                  type="tel"
                  required
                  placeholder="+351 912 345 678"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-cobalt-200 bg-white focus:outline-hidden focus:ring-2 focus:ring-[#0B357B] text-xs"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block font-semibold text-granite-700 mb-1">Check-in Date *</label>
                <input
                  type="date"
                  required
                  class="w-full px-3 py-2 rounded-xl border border-cobalt-200 bg-white focus:outline-hidden focus:ring-2 focus:ring-[#0B357B] text-xs"
                />
              </div>
              <div>
                <label class="block font-semibold text-granite-700 mb-1">Check-out Date *</label>
                <input
                  type="date"
                  required
                  class="w-full px-3 py-2 rounded-xl border border-cobalt-200 bg-white focus:outline-hidden focus:ring-2 focus:ring-[#0B357B] text-xs"
                />
              </div>
              <div>
                <label class="block font-semibold text-granite-700 mb-1">Preferred Unit</label>
                <select
                  class="w-full px-3 py-2 rounded-xl border border-cobalt-200 bg-white focus:outline-hidden focus:ring-2 focus:ring-[#0B357B] text-xs"
                >
                  <option value="studio">Studio (from 70€)</option>
                  <option value="t1">1-Bedroom Apartment (from 80€)</option>
                  <option value="t3">3-Bedroom Apartment (from 180€)</option>
                  <option value="any">Any available unit</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block font-semibold text-granite-700 mb-1">Special Request (Crib, Arrival Time, etc.)</label>
              <textarea
                rows="3"
                placeholder="Number of adults, children, or any special requests for your stay..."
                class="w-full px-3.5 py-2 rounded-xl border border-cobalt-200 bg-white focus:outline-hidden focus:ring-2 focus:ring-[#0B357B] text-xs"
              ></textarea>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
              <button
                type="submit"
                class="w-full sm:w-auto px-6 py-3 rounded-full bg-[#0B357B] hover:bg-cobalt-900 text-white font-bold uppercase tracking-wider text-xs shadow-sm transition-all hover:scale-105 active:scale-95 cursor-pointer"
              >
                Submit Reservation Request
              </button>
              <a
                href="https://wa.me/351933176678?text=Hello%20Casa%20Feij%C3%A3o!%20I%20would%20like%20to%20inquire%20about%20availability%20for%20my%20dates."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto text-center px-5 py-2.5 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2 group"
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8.01 12.27C8.14 12.44 9.76 14.94 12.24 16C12.83 16.27 13.28 16.42 13.64 16.53C14.25 16.73 14.8 16.7 15.24 16.63C15.73 16.56 16.74 16.02 16.95 15.43C17.16 14.84 17.16 14.34 17.1 14.23C17.04 14.12 16.88 14.06 16.64 13.94C16.4 13.82 15.21 13.23 14.99 13.15C14.77 13.07 14.61 13.03 14.45 13.27C14.29 13.51 13.82 14.06 13.68 14.23C13.54 14.39 13.4 14.41 13.16 14.29C12.92 14.17 12.15 13.92 11.24 13.11C10.53 12.48 10.05 11.7 9.91 11.46C9.77 11.22 9.9 11.09 10.02 10.97C10.13 10.86 10.27 10.68 10.39 10.54C10.5 10.4 10.55 10.3 10.63 10.14C10.71 9.97 10.67 9.83 10.61 9.71C10.55 9.59 10.08 8.42 9.88 7.95C9.69 7.49 9.49 7.55 9.34 7.54C9.2 7.54 9.04 7.33 8.53 7.33Z"/>
                </svg>
                <span>Or Send via WhatsApp</span>
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
