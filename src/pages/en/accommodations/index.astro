---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { rooms } from '../../../data/rooms';
---

<BaseLayout
  title="Accommodations • Studio, 1-Bedroom & 3-Bedroom • Casa Feijão Gerês"
  description="Compare our three guesthouse accommodations in Gerês: Mountain Studio from 70€, 1-Bedroom Apartment with fireplace from 80€, and 3-Bedroom Family Residence from 180€. Full kitchens and scenic views."
  lang="en"
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-[#FAFBFD] to-white border-b border-cobalt-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Accommodations' }]} lang="en" className="mb-6" />
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-cobalt-950 tracking-tight">
          Sanctuary Accommodations in Gerês
        </h1>
      <p class="mt-4 text-sm sm:text-base text-granite-600 leading-relaxed font-sans">
        Three self-catering units crafted for couples, families, and hiking groups. All units feature private fully-equipped kitchens, central heating, free private parking, and complimentary linens & towels.
      </p>

        <!-- Key badges -->
        <div class="flex flex-wrap items-center justify-center gap-3 mt-6 text-xs text-cobalt-900 font-semibold">
          <span class="px-3 py-1 rounded-full bg-white border border-cobalt-200 shadow-2xs">✓ Bed linen & towels included</span>
          <span class="px-3 py-1 rounded-full bg-white border border-cobalt-200 shadow-2xs">✓ Free High-Speed Wi-Fi & Parking</span>
          <span class="px-3 py-1 rounded-full bg-white border border-cobalt-200 shadow-2xs">✓ 6 min walk to Caniçada river beach</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    <!-- ROOMS GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {rooms.map((room) => (
        <article class="bg-[#FAFBFD] rounded-3xl overflow-hidden border-2 border-cobalt-100 hover:border-cobalt-300 shadow-tile hover:shadow-tile-hover transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Image with Price Badge -->
            <div class="relative h-64 overflow-hidden">
              <img
                src={room.featuredImage}
                alt={room.titleEn}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-[#0B357B] border border-cobalt-100 shadow-xs">
                {room.viewsEn.split(',')[0]}
              </div>
              <div class="absolute bottom-4 right-4 bg-[#0B357B] text-white px-4 py-1.5 rounded-xl text-xs font-sans font-semibold shadow-md">
                from <span class="text-base text-amber-300 font-bold">{room.pricePerNight}€</span> / night
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-2xl font-serif font-black text-cobalt-950 group-hover:text-[#0B357B] transition-colors leading-tight">
                  {room.titleEn}
                </h2>
                {room.area && (
                  <span class="shrink-0 whitespace-nowrap text-xs font-mono font-bold px-2.5 py-1 rounded-lg bg-cobalt-50 border border-cobalt-200/90 text-[#0B357B] mt-0.5 shadow-2xs">
                    {room.area}
                  </span>
                )}
              </div>

              <p class="text-xs font-semibold text-cobalt-700 flex items-center gap-1.5">
                <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
                  <path d="M208,80H48V56a8,8,0,0,0-16,0V200a8,8,0,0,0,16,0V176H224v24a8,8,0,0,0,16,0V112A32,32,0,0,0,208,80ZM48,96H104v64H48Zm176,64H120V96h88a16,16,0,0,1,16,16Z"/>
                </svg>
                <span>{room.capacity.bedsEn} • up to {room.capacity.adults + room.capacity.children} guests</span>
              </p>

              <p class="text-xs text-granite-600 leading-relaxed">
                {room.descriptionEn}
              </p>

              <!-- Highlights -->
              <div class="pt-2 border-t border-cobalt-100/80 space-y-2">
                <span class="text-[10px] font-mono uppercase tracking-wider text-granite-400 font-bold block">
                  Residence Highlights:
                </span>
                <ul class="space-y-1.5 text-xs text-granite-700">
                  {room.highlightsEn.map((hl) => (
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-600 font-bold">✓</span>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Bottom Action -->
          <div class="p-6 sm:p-8 pt-0 space-y-2">
            <a
              href={`/en/accommodations/${room.slug === 'apartamento-t1' ? 'apartamento-t1' : room.slug === 'apartamento-t3' ? 'apartamento-t3' : 'estudio'}`}
              class="block w-full py-3 text-center rounded-xl bg-[#0B357B] hover:bg-cobalt-900 text-white text-xs font-bold uppercase tracking-wider shadow-sm transition-all hover:scale-[1.02] active:scale-[0.98]"
            >
              View Full Gallery & Specs →
            </a>
            <a
              href={`/en/contact?room=${room.slug}#booking`}
              class="block w-full py-2 text-center rounded-xl bg-white border border-cobalt-200 hover:bg-cobalt-50 text-[#0B357B] text-xs font-semibold transition-colors"
            >
              Check Direct Availability
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- SIDE-BY-SIDE COMPARISON TABLE -->
    <section class="bg-white rounded-3xl border border-cobalt-100 p-6 sm:p-10 shadow-tile overflow-hidden">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-2xl sm:text-3xl font-serif font-black text-cobalt-950">
          Accommodations Comparison Matrix
        </h2>
        <p class="text-xs sm:text-sm text-granite-500 mt-2">
          Compare specifications side-by-side to choose the perfect base for your Gerês retreat
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b-2 border-cobalt-200 bg-[#FAFBFD]">
              <th class="p-4 font-serif font-bold text-sm text-[#0B357B]">Feature / Specification</th>
              <th class="p-4 font-serif font-bold text-sm text-cobalt-950 text-center">Studio</th>
              <th class="p-4 font-serif font-bold text-sm text-cobalt-950 text-center">Apartment T1</th>
              <th class="p-4 font-serif font-bold text-sm text-cobalt-950 text-center">Apartment T3</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cobalt-100">
            <tr>
              <td class="p-4 font-semibold text-granite-800">Starting Price / Night</td>
              <td class="p-4 text-center font-mono font-bold text-[#0B357B] text-sm">from 70€</td>
              <td class="p-4 text-center font-mono font-bold text-[#0B357B] text-sm">from 80€</td>
              <td class="p-4 text-center font-mono font-bold text-[#0B357B] text-sm">from 180€</td>
            </tr>
            <tr class="bg-cobalt-50/30">
              <td class="p-4 font-semibold text-granite-800">Private Surface Area</td>
              <td class="p-4 text-center font-mono text-granite-600">Open Plan Studio</td>
              <td class="p-4 text-center font-mono font-bold text-cobalt-950">40 m²</td>
              <td class="p-4 text-center font-mono font-bold text-cobalt-950">70 m²</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-granite-800">Bedrooms & Layout</td>
              <td class="p-4 text-center text-granite-600">1 Double Bed + Sofa Bed</td>
              <td class="p-4 text-center text-granite-600">1 Private Bedroom + Sofa Bed</td>
              <td class="p-4 text-center font-semibold text-cobalt-950">3 Separate Bedrooms + Sofa Bed</td>
            </tr>
            <tr class="bg-cobalt-50/30">
              <td class="p-4 font-semibold text-granite-800">Traditional Fireplace</td>
              <td class="p-4 text-center text-granite-400">—</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Yes</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Yes (Grand Hearth)</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-granite-800">Scenic Balcony</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Balcony with views</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Private balcony</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Full wrap-around balcony</td>
            </tr>
            <tr class="bg-cobalt-50/30">
              <td class="p-4 font-semibold text-granite-800">Kitchen & Appliances</td>
              <td class="p-4 text-center text-granite-600">Stovetop, microwave, fridge</td>
              <td class="p-4 text-center text-granite-600">Full kitchen with oven</td>
              <td class="p-4 text-center font-semibold text-cobalt-950">Spacious family kitchen</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-granite-800">Central Heating & Hot Water</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Included</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Included</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Included</td>
            </tr>
            <tr class="bg-cobalt-50/30">
              <td class="p-4 font-semibold text-granite-800">Wi-Fi & Satellite Flat-Screen TV</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-granite-800">Outdoor BBQ Access</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free access</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free access</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free access</td>
            </tr>
            <tr class="bg-cobalt-50/30">
              <td class="p-4 font-semibold text-granite-800">Private Parking</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free on-site</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free on-site</td>
              <td class="p-4 text-center text-emerald-600 font-bold">✓ Free on-site</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- POLICIES & RESERVATION TERMS -->
    <section class="bg-[#FAFBFD] rounded-3xl border border-cobalt-100 p-8 sm:p-10 shadow-tile space-y-8">
      <div class="border-b border-cobalt-100 pb-4">
        <span class="text-xs font-mono uppercase tracking-widest text-[#0B357B] font-bold">Essential Information</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-black text-cobalt-950 mt-1">
          Booking Terms & House Policies
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-xs text-granite-700">
        <div class="p-5 rounded-2xl bg-white border border-cobalt-100 space-y-2">
          <div class="font-bold text-[#0B357B] flex items-center gap-2">
            <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"/>
            </svg>
            <span>Check-in & Check-out</span>
          </div>
          <p>• <strong>Check-in:</strong> 16:00 – 20:00</p>
          <p>• <strong>Check-out:</strong> 08:00 – 11:00</p>
          <p class="text-[11px] text-granite-500">Please communicate your expected arrival time in advance.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-cobalt-100 space-y-2">
          <div class="font-bold text-[#0B357B] flex items-center gap-2">
            <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216ZM168,108a12,12,0,1,1-12-12A12,12,0,0,1,168,108Zm-68,0a12,12,0,1,1-12-12A12,12,0,0,1,100,108Zm60,44a40,40,0,0,1-64,0,8,8,0,0,1,12.8-9.6,24,24,0,0,0,38.4,0,8,8,0,0,1,12.8,9.6Z"/>
            </svg>
            <span>Children & Extra Beds</span>
          </div>
          <p>• <strong>Under 2 years:</strong> Free baby crib (upon request)</p>
          <p>• <strong>3 to 12 years:</strong> 10€/night extra bed</p>
          <p>• <strong>13+ years / Adults:</strong> 15€/night extra bed</p>
          <p class="text-[11px] text-granite-500">Up to 2 extra beds/cribs per unit, subject to availability.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-cobalt-100 space-y-2">
          <div class="font-bold text-[#0B357B] flex items-center gap-2">
            <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
              <path d="M224,48H32A16,16,0,0,0,16,64V192a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V64A16,16,0,0,0,224,48Zm0,16V88H32V64Zm0,128H32V128H224v64Zm-16-24a8,8,0,0,1-8,8H168a8,8,0,0,1,0-16h32A8,8,0,0,1,208,168Zm-64,0a8,8,0,0,1-8,8H120a8,8,0,0,1,0-16h16A8,8,0,0,1,144,168Z"/>
            </svg>
            <span>Payment & Cancellation</span>
          </div>
          <p>• <strong>Payment on site:</strong> Cash only</p>
          <p>• <strong>Cancellation:</strong> Conditions vary depending on season and unit booked</p>
          <p class="text-[11px] text-granite-500">Zero intermediary commissions when booking directly.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-cobalt-100 space-y-2">
          <div class="font-bold text-[#0B357B] flex items-center gap-2">
            <svg class="w-4 h-4 fill-current text-[#0B357B] shrink-0" viewBox="0 0 256 256">
              <path d="M84,108a20,20,0,1,1,20-20A20,20,0,0,1,84,108Zm44-12a20,20,0,1,0-20-20A20,20,0,0,0,128,96Zm44,12a20,20,0,1,0-20-20A20,20,0,0,0,172,108ZM36,132a20,20,0,1,0,20-20A20,20,0,0,0,36,132Zm184,0a20,20,0,1,0-20-20A20,20,0,0,0,220,132Zm-46.7,29.17a52.1,52.1,0,0,0-90.6,0A32,32,0,0,0,64,192a32,32,0,0,0,51.87,24.9,76.54,76.54,0,0,1,24.26,0A32,32,0,0,0,192,192,32,32,0,0,0,173.3,161.17Z"/>
            </svg>
            <span>House Guidelines</span>
          </div>
          <p>• <strong>Pets:</strong> Pets are not allowed</p>
          <p>• <strong>Smoking:</strong> Strictly non-smoking accommodations</p>
          <p>• <strong>Linens & Towels:</strong> Clean sets provided complimentary</p>
        </div>
      </div>
    </section>

    <!-- DIRECT INQUIRY CTA -->
    <section class="rounded-3xl bg-[#0B357B] text-white p-8 sm:p-12 text-center relative overflow-hidden shadow-tile">
      <div class="max-w-2xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-serif font-black">
          Ready to Reserve Your Mountain Getaway?
        </h3>
        <p class="text-xs sm:text-sm text-cobalt-100 leading-relaxed font-sans">
          Reach out directly to secure the best rates, verify real-time dates, and discuss personalized tips with your local hosts.
        </p>
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="https://wa.me/351933176678?text=Hello%20Casa%20Feij%C3%A3o!%20I%20would%20like%20to%20check%20availability%20for%20accommodations."
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white text-xs font-bold uppercase tracking-wider transition-all shadow-sm flex items-center gap-2 group"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8.01 12.27C8.14 12.44 9.76 14.94 12.24 16C12.83 16.27 13.28 16.42 13.64 16.53C14.25 16.73 14.8 16.7 15.24 16.63C15.73 16.56 16.74 16.02 16.95 15.43C17.16 14.84 17.16 14.34 17.1 14.23C17.04 14.12 16.88 14.06 16.64 13.94C16.4 13.82 15.21 13.23 14.99 13.15C14.77 13.07 14.61 13.03 14.45 13.27C14.29 13.51 13.82 14.06 13.68 14.23C13.54 14.39 13.4 14.41 13.16 14.29C12.92 14.17 12.15 13.92 11.24 13.11C10.53 12.48 10.05 11.7 9.91 11.46C9.77 11.22 9.9 11.09 10.02 10.97C10.13 10.86 10.27 10.68 10.39 10.54C10.5 10.4 10.55 10.3 10.63 10.14C10.71 9.97 10.67 9.83 10.61 9.71C10.55 9.59 10.08 8.42 9.88 7.95C9.69 7.49 9.49 7.55 9.34 7.54C9.2 7.54 9.04 7.33 8.53 7.33Z"/>
            </svg>
            <span>Book via WhatsApp (+351 933 176 678)</span>
          </a>
          <a
            href="/en/contact#booking"
            class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full bg-white text-[#0B357B] hover:bg-cobalt-50 text-xs font-bold uppercase tracking-wider transition-all shadow-sm"
          >
            <span>Contact Inquiry Form</span>
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
              <path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
