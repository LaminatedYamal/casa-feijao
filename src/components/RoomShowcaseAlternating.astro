---
// src/components/RoomShowcaseAlternating.astro
import { rooms } from '../data/rooms';
import RoomAmenitiesList from './RoomAmenitiesList.astro';

interface Props {
  lang?: 'pt' | 'en';
}

const { lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';
---

<section class="py-20 bg-porcelain border-y border-cobalt-100 overflow-hidden">
  <!-- Section Title & Subtitle (Centered) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 text-center">
    <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0B357B]">
      {isPt ? 'Tipologias Independentes' : 'Independent Living Spaces'}
    </span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-cobalt-950 font-bold mt-2">
      {isPt ? 'Escolha o Seu Espaço no Gerês' : 'Choose Your Space in Gerês'}
    </h2>
    <p class="mt-4 text-granite-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      {isPt
        ? 'Estúdios acolhedores para escapadinhas a dois ou apartamentos amplos com lareira tradicional para toda a família.'
        : 'From cozy studios for romantic escapes to spacious residences with traditional granite fireplaces for family retreats.'}
    </p>
  </div>

  <!-- Alternating Full-Bleed Rooms: Exactly like the Estate section at the top -->
  <div class="space-y-20 lg:space-y-32">
    {rooms.map((room, idx) => {
      const isPhotoLeft = idx % 2 === 1; // Room 1: Text Left / Photo Right; Room 2: Photo Left / Text Right; Room 3: Text Left / Photo Right
      const roomUrl = isPt ? `/acomodacoes/${room.slug}` : `/en/accommodations/${room.slug}`;

      return (
        <article class="w-full flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
          
          <!-- Text Box (Clean isolated card/box) -->
          <div
            class={`w-full lg:w-[460px] xl:w-[500px] shrink-0 flex flex-col justify-center space-y-5 lg:space-y-6 ${
              isPhotoLeft
                ? 'lg:order-2 pr-4 sm:pr-8 lg:pr-16 pl-4 sm:pl-8 lg:pl-0'
                : 'lg:order-1 pl-4 sm:pl-8 lg:pl-16 pr-4 sm:pr-8 lg:pr-0'
            }`}
          >
            <!-- Room Header: Subtitle & Price Badge -->
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#0B357B]">
                {isPt ? room.subtitlePt : room.subtitleEn}
              </span>
              <div class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-[#0B357B] text-white font-sans text-xs font-semibold shadow-xs">
                <span>{isPt ? 'desde' : 'from'}</span>
                <span class="text-base text-amber-300 font-bold ml-1">{room.pricePerNight}€</span>
                <span class="text-[10px] text-slate-200 font-normal">/{isPt ? 'noite' : 'night'}</span>
              </div>
            </div>

            <!-- Room Title -->
            <h3 class="text-3xl sm:text-4xl font-serif font-black text-cobalt-950 tracking-tight leading-[1.15]">
              <a href={roomUrl} class="hover:text-[#0B357B] transition-colors">
                {isPt ? room.titlePt : room.titleEn}
              </a>
            </h3>

            <!-- Capacity & Beds -->
            <p class="text-xs text-granite-500 font-medium">
              {isPt ? room.capacity.bedsPt : room.capacity.bedsEn} {room.area ? `• ${room.area}` : ''}
            </p>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-granite-600 leading-relaxed font-sans">
              {isPt ? room.descriptionPt : room.descriptionEn}
            </p>

            <!-- Animated Amenities (Animated SVG icons, 1-2 words, zero background boxes) -->
            <div class="pt-1">
              <RoomAmenitiesList slug={room.slug} lang={lang} />
            </div>

            <!-- CTAs: Book Details + WhatsApp Direct -->
            <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href={roomUrl}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#0B357B] hover:bg-[#1A54A6] text-white text-xs font-bold uppercase tracking-wider transition-all duration-200 shadow-sm active:scale-98"
              >
                <span>{isPt ? 'Ver Detalhes & Reservar' : 'View Details & Book'}</span>
                <span>→</span>
              </a>
              <a
                href="https://wa.me/351933176678"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-200 transition-colors"
              >
                <!-- Official WhatsApp SVG -->
                <svg class="w-3.5 h-3.5 fill-current text-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8.01 12.27C8.14 12.44 9.76 14.94 12.24 16C12.83 16.27 13.28 16.42 13.64 16.53C14.25 16.73 14.8 16.7 15.24 16.63C15.73 16.56 16.74 16.02 16.95 15.43C17.16 14.84 17.16 14.34 17.1 14.23C17.04 14.12 16.88 14.06 16.64 13.94C16.4 13.82 15.21 13.23 14.99 13.15C14.77 13.07 14.61 13.03 14.45 13.27C14.29 13.51 13.82 14.06 13.68 14.23C13.54 14.39 13.4 14.41 13.16 14.29C12.92 14.17 12.15 13.92 11.24 13.11C10.53 12.48 10.05 11.7 9.91 11.46C9.77 11.22 9.9 11.09 10.02 10.97C10.13 10.86 10.27 10.68 10.39 10.54C10.5 10.4 10.55 10.3 10.63 10.14C10.71 9.97 10.67 9.83 10.61 9.71C10.55 9.59 10.08 8.42 9.88 7.95C9.69 7.49 9.49 7.55 9.34 7.54C9.2 7.54 9.04 7.33 8.53 7.33Z"/>
                </svg>
                <span>{isPt ? 'Disponibilidade' : 'Inquire via WhatsApp'}</span>
              </a>
            </div>
          </div>

          <!-- Unboxed Photo Viewport: EXACTLY like Estate Showcase, ONE horizontal photo at a time, edge-to-edge -->
          <div
            class={`w-full flex-1 overflow-x-auto snap-x snap-mandatory scrollbar-none flex items-center py-2 ${
              isPhotoLeft
                ? 'lg:order-1 pl-0 pr-4 sm:pr-8 lg:pr-0'
                : 'lg:order-2 pr-0 pl-4 sm:pl-8 lg:pl-0'
            }`}
          >
            <div
              id={`room-track-${room.slug}`}
              class="flex flex-row items-center w-full h-full"
            >
              {room.galleryImages.map((img, imgIdx) => (
                <div class={`snap-start snap-always shrink-0 w-full h-full flex items-center ${isPhotoLeft ? 'justify-start pl-0' : 'justify-end pr-0'}`}>
                  <div
                    class={`w-full h-[360px] sm:h-[460px] lg:h-[72vh] overflow-hidden shadow-2xl border-y-2 border-white/90 bg-slate-900 relative group/photo ${
                      isPhotoLeft
                        ? 'rounded-r-3xl rounded-l-none border-r-2'
                        : 'rounded-l-3xl rounded-r-none border-l-2'
                    }`}
                  >
                    <img
                      src={img}
                      alt={`${isPt ? room.titlePt : room.titleEn} - Foto ${imgIdx + 1}`}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/photo:scale-105"
                      loading={imgIdx === 0 ? "eager" : "lazy"}
                    />
                    <!-- Subtle floating counter pill in the corner -->
                    <div class="absolute bottom-4 right-4 px-3 py-1 rounded-xl bg-black/70 backdrop-blur-xs text-[11px] font-mono text-white pointer-events-none">
                      {imgIdx + 1} / {room.galleryImages.length}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </article>
      );
    })}
  </div>
</section>

<script>
  // Add smooth mousewheel-to-horizontal-scroll so scrolling over the image moves to the next picture
  document.querySelectorAll<HTMLElement>('[id^="room-track-"]').forEach((track) => {
    const parentViewport = track.parentElement;
    if (!parentViewport) return;

    parentViewport.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault();
        const slideWidth = parentViewport.clientWidth;
        parentViewport.scrollBy({
          left: e.deltaY > 0 ? slideWidth : -slideWidth,
          behavior: 'smooth',
        });
      }
    }, { passive: false });
  });
</script>
