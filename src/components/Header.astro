---
// src/components/Header.astro
import { CasaFeijaoLogoLockup } from './CasaFeijaoLogoLockup';
import { ActualWeatherWidget } from './ActualWeatherWidget';
import { MobileHeaderMenu } from './MobileHeaderMenu';

interface Props {
  lang?: 'pt' | 'en';
  currentPath?: string;
  isHeroMuralPage?: boolean;
}

const { lang = 'pt', currentPath = '', isHeroMuralPage = false } = Astro.props;
const isPt = lang === 'pt';

const accommodationsHref = isPt ? '/acomodacoes' : '/en/accommodations';
const geresHref = isPt ? '/geres' : '/en/geres';
const facilitiesHref = isPt ? '/facilidades' : '/en/facilities';
const contactsHref = isPt ? '/contactos' : '/en/contact';
const homeHref = isPt ? '/' : '/en';
---

{/* Render header on all subpages. Homepage has the animated Azulejo Mural entrance */}
{!isHeroMuralPage && (
  <>
    <header class="fixed top-0 left-0 right-0 md:sticky md:top-0 z-50 pt-[env(safe-area-inset-top,0px)] h-[calc(74px+env(safe-area-inset-top,0px))] sm:h-[88px] md:h-[116px] lg:h-[124px] bg-[#FAFBFD] border-b border-cobalt-100 shadow-sm transition-all duration-200">
    <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 flex items-center justify-between">
      
      <!-- Left side: Desktop navigation links (hidden on mobile, moved to menu) -->
      <nav class="hidden md:flex flex-1 items-center justify-start gap-3.5 lg:gap-6 xl:gap-7">
        <!-- Accommodations with Flyout Dropdown -->
        <div class="relative group py-2">
          <a
            href={accommodationsHref}
            class={`text-xs sm:text-sm font-semibold transition-colors duration-200 flex items-center gap-1 ${
              currentPath.includes('/acomodacoes') || currentPath.includes('/accommodations')
                ? 'text-[#0B357B] font-bold border-b-2 border-[#0B357B] pb-0.5'
                : 'text-granite-700 hover:text-[#0B357B]'
            }`}
          >
            <span>{isPt ? 'Acomodações' : 'Accommodations'}</span>
            <svg class="w-3 h-3 text-granite-400 group-hover:text-[#0B357B] group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <!-- Flyout for individual rooms -->
          <div class="absolute top-full left-0 pt-1.5 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl shadow-xl border border-cobalt-100 py-2 px-1 min-w-[210px]">
              <a
                href={isPt ? '/acomodacoes/estudio' : '/en/accommodations/estudio'}
                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-granite-700 hover:text-[#0B357B] hover:bg-cobalt-50/70 transition-colors"
              >
                <span>{isPt ? 'Estúdio' : 'Studio'}</span>
                <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded">70€</span>
              </a>
              <a
                href={isPt ? '/acomodacoes/apartamento-t1' : '/en/accommodations/apartamento-t1'}
                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-granite-700 hover:text-[#0B357B] hover:bg-cobalt-50/70 transition-colors"
              >
                <span>{isPt ? 'Apartamento T1' : 'Apartment T1'}</span>
                <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded">95€</span>
              </a>
              <a
                href={isPt ? '/acomodacoes/apartamento-t3' : '/en/accommodations/apartamento-t3'}
                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-granite-700 hover:text-[#0B357B] hover:bg-cobalt-50/70 transition-colors"
              >
                <span>{isPt ? 'Apartamento T3' : 'Apartment T3'}</span>
                <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded">150€</span>
              </a>
              <div class="my-1 border-t border-cobalt-50"></div>
              <a
                href={accommodationsHref}
                class="block px-3 py-1.5 text-[11px] font-bold text-[#0B357B] hover:underline"
              >
                {isPt ? 'Ver Todas as Acomodações →' : 'View All Accommodations →'}
              </a>
            </div>
          </div>
        </div>

        <a
          href={geresHref}
          class={`text-xs sm:text-sm font-semibold transition-colors duration-200 ${
            currentPath.includes('/geres')
              ? 'text-[#0B357B] font-bold border-b-2 border-[#0B357B] pb-0.5'
              : 'text-granite-700 hover:text-[#0B357B]'
          }`}
        >
          {isPt ? 'Guia do Gerês' : 'Gerês Guide'}
        </a>

        <a
          href={facilitiesHref}
          class={`text-xs sm:text-sm font-semibold transition-colors duration-200 ${
            currentPath.includes('/facilidades') || currentPath.includes('/facilities')
              ? 'text-[#0B357B] font-bold border-b-2 border-[#0B357B] pb-0.5'
              : 'text-granite-700 hover:text-[#0B357B]'
          }`}
        >
          {isPt ? 'Facilidades' : 'Facilities'}
        </a>

        <a
          href={contactsHref}
          class={`text-xs sm:text-sm font-semibold transition-colors duration-200 ${
            currentPath.includes('/contactos') || currentPath.includes('/contact')
              ? 'text-[#0B357B] font-bold border-b-2 border-[#0B357B] pb-0.5'
              : 'text-granite-700 hover:text-[#0B357B]'
          }`}
        >
          {isPt ? 'Contactos' : 'Contacts'}
        </a>
      </nav>

      <!-- Mobile left spacer: exact same width as right hamburger button (w-10) to guarantee true optical centering -->
      <div class="w-10 shrink-0 md:hidden" aria-hidden="true"></div>

      <!-- Center: Casa Feijão Medallion Logo Lockup (True Center) -->
      <div class="flex-shrink-0 flex items-center justify-center px-4">
        <a
          href={homeHref}
          class="group flex flex-col items-center justify-center transition-transform hover:scale-105 active:scale-95 duration-200"
          title={isPt ? 'Casa Feijão • Início' : 'Casa Feijão • Home'}
        >
          <div class="md:hidden">
            <CasaFeijaoLogoLockup client:load lang={lang} size="sm" />
          </div>
          <div class="hidden md:block">
            <CasaFeijaoLogoLockup client:load lang={lang} size="md" />
          </div>
        </a>
      </div>

      <!-- Right side: Desktop weather & WhatsApp + Mobile Hamburger Drawer -->
      <div class="w-10 shrink-0 md:flex-1 flex items-center justify-end gap-2.5 sm:gap-4">
        <!-- The Actual Weather Widget for Gerês (Desktop) -->
        <ActualWeatherWidget client:load lang={lang} className="hidden lg:flex w-[170px] lg:w-[190px] h-[46px]" />

        <!-- Direct WhatsApp Quick Action (Desktop/Tablet) -->
        <a
          href="https://wa.me/351933176678"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white text-xs font-semibold shadow-xs transition-colors shrink-0"
          title={isPt ? 'Falar no WhatsApp' : 'Chat on WhatsApp'}
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8.01 12.27C8.14 12.44 9.76 14.94 12.24 16C12.83 16.27 13.28 16.42 13.64 16.53C14.25 16.73 14.8 16.7 15.24 16.63C15.73 16.56 16.74 16.02 16.95 15.43C17.16 14.84 17.16 14.34 17.1 14.23C17.04 14.12 16.88 14.06 16.64 13.94C16.4 13.82 15.21 13.23 14.99 13.15C14.77 13.07 14.61 13.03 14.45 13.27C14.29 13.51 13.82 14.06 13.68 14.23C13.54 14.39 13.4 14.41 13.16 14.29C12.92 14.17 12.15 13.92 11.24 13.11C10.53 12.48 10.05 11.7 9.91 11.46C9.77 11.22 9.9 11.09 10.02 10.97C10.13 10.86 10.27 10.68 10.39 10.54C10.5 10.4 10.55 10.3 10.63 10.14C10.71 9.97 10.67 9.83 10.61 9.71C10.55 9.59 10.08 8.42 9.88 7.95C9.69 7.49 9.49 7.55 9.34 7.54C9.2 7.54 9.04 7.33 8.53 7.33Z"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <!-- Mobile Drawer Hamburger Menu -->
        <div class="md:hidden">
          <MobileHeaderMenu client:load lang={lang} currentPath={currentPath} />
        </div>
      </div>

    </div>
  </header>
    {/* Mobile document-flow spacer so page content starts cleanly below the fixed header on phones (zero shift) */}
    <div class="h-[calc(74px+env(safe-area-inset-top,0px))] sm:h-[88px] md:hidden" aria-hidden="true"></div>
  </>
)}