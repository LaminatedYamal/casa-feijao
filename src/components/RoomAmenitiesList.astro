---
// src/components/RoomAmenitiesList.astro
interface Props {
  slug: string;
  lang?: 'pt' | 'en';
}

const { slug, lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';

const amenitiesBySlug: Record<string, { pt: Array<{ icon: string; label: string }>; en: Array<{ icon: string; label: string }> }> = {
  estudio: {
    pt: [
      { icon: 'wifi', label: 'Wi-Fi Gratuito' },
      { icon: 'heating', label: 'Aquecimento Central' },
      { icon: 'parking', label: 'Parque Privado' },
      { icon: 'kitchen', label: 'Kitchenette Completa' },
    ],
    en: [
      { icon: 'wifi', label: 'Free Wi-Fi' },
      { icon: 'heating', label: 'Central Heating' },
      { icon: 'parking', label: 'Private Parking' },
      { icon: 'kitchen', label: 'Equipped Kitchenette' },
    ],
  },
  'apartamento-t1': {
    pt: [
      { icon: 'wifi', label: 'Wi-Fi Gratuito' },
      { icon: 'fireplace', label: 'Lareira em Pedra' },
      { icon: 'balcony', label: 'Varanda c/ Vista' },
      { icon: 'kitchen', label: 'Cozinha Completa' },
    ],
    en: [
      { icon: 'wifi', label: 'Free Wi-Fi' },
      { icon: 'fireplace', label: 'Stone Fireplace' },
      { icon: 'balcony', label: 'Scenic Balcony' },
      { icon: 'kitchen', label: 'Full Kitchen' },
    ],
  },
  'apartamento-t3': {
    pt: [
      { icon: 'users', label: 'Até 8 Pessoas' },
      { icon: 'bed', label: '3 Quartos Amplos' },
      { icon: 'parking', label: 'Parque Privado' },
      { icon: 'fireplace', label: 'Lareira Tradicional' },
    ],
    en: [
      { icon: 'users', label: 'Up to 8 Guests' },
      { icon: 'bed', label: '3 Large Bedrooms' },
      { icon: 'parking', label: 'Private Parking' },
      { icon: 'fireplace', label: 'Traditional Fireplace' },
    ],
  },
};

const items = amenitiesBySlug[slug]?.[isPt ? 'pt' : 'en'] || [];
---

<div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-4 pt-3.5 border-t border-cobalt-100/70 font-sans">
  {items.map((item) => (
    <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-granite-700 hover:text-[#0B357B] transition-colors cursor-default">
      {item.icon === 'wifi' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor WifiHigh -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M245.66,90.34a168,168,0,0,0-235.32,0,8,8,0,0,0,11.32,11.32,152,152,0,0,1,212.68,0,8,8,0,0,0,11.32-11.32Zm-28.29,28.29a128,128,0,0,0-178.74,0,8,8,0,0,0,11.32,11.32,112,112,0,0,1,156.1,0,8,8,0,0,0,11.32-11.32Zm-28.28,28.28a88.08,88.08,0,0,0-122.18,0,8,8,0,0,0,11.32,11.32,72.07,72.07,0,0,1,99.54,0,8,8,0,0,0,11.32-11.32ZM128,184a16,16,0,1,0,16,16A16,16,0,0,0,128,184Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'heating' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor Flame -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M173.86,99.43a8,8,0,0,0-8.58-1.57C146.4,104.91,136,88,136,64a97.16,97.16,0,0,1,21-60.67,8,8,0,0,0-9.2-12.7A115.53,115.53,0,0,0,104,72c0,30.34-19,53-39.73,62.88a8,8,0,0,0-4,10.29,103.54,103.54,0,0,0,29.17,42.54A80,80,0,1,0,208,144C208,124.64,195.42,107.57,173.86,99.43ZM128,240a64.08,64.08,0,0,1-63.53-71.18c22.56-11.5,41-33.82,43.27-61.91A127,127,0,0,1,120,73.49c6,14.65,16.59,28.53,30.68,34.95C171,117.84,192,128.7,192,144A64.07,64.07,0,0,1,128,240Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'parking' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor Car -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M240,112H228.84L208.57,51.2A16,16,0,0,0,193.41,40H62.59a16,16,0,0,0-15.16,11.2L27.16,112H16a8,8,0,0,0,0,16h8v80a16,16,0,0,0,16,16H64a16,16,0,0,0,16-16V192h96v16a16,16,0,0,0,16,16h24a16,16,0,0,0,16-16V128h8a8,8,0,0,0,0-16ZM62.59,56H193.41l18.67,56H43.92ZM64,208H40V128H80v64H64Zm128,0v-16H112V128h80v80h-16Zm24-40a12,12,0,1,1,12-12A12,12,0,0,1,216,168ZM52,144a12,12,0,1,1-12,12A12,12,0,0,1,52,144Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'balcony' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor SunHorizon -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,0,0-128,0,8,8,0,0,0,16,0,48,48,0,0,1,96,0,8,8,0,0,0,16,0ZM59,70.34a8,8,0,0,0-11.31-11.31L30.34,76.34A8,8,0,0,0,41.66,87.66ZM225.66,76.34l-17.32-17.31A8,8,0,0,0,197,70.34l17.31,17.32a8,8,0,0,0,11.32-11.32ZM248,152H232a8,8,0,0,0,0,16h16a8,8,0,0,0,0-16ZM24,152H8a8,8,0,0,0,0,16H24a8,8,0,0,0,0-16Zm216,40H16a8,8,0,0,0,0,16H240a8,8,0,0,0,0-16Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'fireplace' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor Fire -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M173.86,99.43a8,8,0,0,0-8.58-1.57C146.4,104.91,136,88,136,64a97.16,97.16,0,0,1,21-60.67,8,8,0,0,0-9.2-12.7A115.53,115.53,0,0,0,104,72c0,30.34-19,53-39.73,62.88a8,8,0,0,0-4,10.29,103.54,103.54,0,0,0,29.17,42.54A80,80,0,1,0,208,144C208,124.64,195.42,107.57,173.86,99.43ZM128,240a64.08,64.08,0,0,1-63.53-71.18c22.56-11.5,41-33.82,43.27-61.91A127,127,0,0,1,120,73.49c6,14.65,16.59,28.53,30.68,34.95C171,117.84,192,128.7,192,144A64.07,64.07,0,0,1,128,240Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'kitchen' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor CookingPot -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M248,104H224V88a8,8,0,0,0-8-8H160a24,24,0,0,0-24-24H120a24,24,0,0,0-24,24H40a8,8,0,0,0-8,8v16H8a8,8,0,0,0,0,16H24v64a40,40,0,0,0,40,40H192a40,40,0,0,0,40-40V120h16a8,8,0,0,0,0-16ZM112,80a8,8,0,0,1,8-8h16a8,8,0,0,1,8,8v16H112Zm104,104a24,24,0,0,1-24,24H64a24,24,0,0,1-24-24V120H216Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'bed' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor Bed -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M208,72H24V48a8,8,0,0,0-16,0V208a8,8,0,0,0,16,0V176H240v32a8,8,0,0,0,16,0V120A48.05,48.05,0,0,0,208,72ZM24,88H96a24,24,0,0,1,24,24v48H24Zm112,24a24,24,0,0,1,24-24h48a32,32,0,0,1,32,32v40H136Z"/>
          </svg>
        </span>
      )}

      {item.icon === 'users' && (
        <span class="w-4 h-4 text-[#0B357B] flex items-center justify-center">
          <!-- Phosphor Users -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 256 256">
            <path d="M117.25,157.92a60,60,0,1,0-66.5,0A95.83,95.83,0,0,0,3.53,195.63a8,8,0,1,0,13.4,8.74,80,80,0,0,1,134.14,0,8,8,0,0,0,13.4-8.74A95.83,95.83,0,0,0,117.25,157.92ZM40,108a44,44,0,1,1,44,44A44.05,44.05,0,0,1,40,108Zm210.14,98.74a8,8,0,0,1-11.07-2.37A79.9,79.9,0,0,0,172,168.13a8,8,0,1,1,5.66-15,95.92,95.92,0,0,1,70.07,43.74A8,8,0,0,1,250.14,206.74ZM172,140a8,8,0,0,1-8-8,44,44,0,1,0-44-44,8,8,0,0,1-16,0,60,60,0,1,1,68,52Z"/>
          </svg>
        </span>
      )}

      <span class="tracking-tight">{item.label}</span>
    </div>
  ))}
</div>
